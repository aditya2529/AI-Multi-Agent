# ─── AI Multi-Agent Scrum Team — gitignore ──────────────────────────────────
# This repo tracks ONLY the AI Scrum Team agent definitions + demo assets.
# Everything else (AI Workforce platform code, demos, secrets) is ignored.

# ── Secrets & local config ──
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
secrets/
vault-tokens/
security/keys/

# ── Python ──
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
.coverage
.coverage_report.json
coverage.xml
htmlcov/
build/
dist/
.venv/
venv/
env/

# ── Node / Frontend ──
node_modules/
.next/
out/
npm-debug.log*
*.log

# ── Docker / Terraform ──
*.tar
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars

# ── IDE / OS ──
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Generated artifacts ──
artifacts/
.langfuse/

# ── Repo-specific: ignore broader AI Workforce platform code ──
# This repo is for the AI Scrum Team only. Other code lives in its own home.
# NOTE: orchestrator/ and docs/ use the star-form so we can re-include the
# guard_rails subsystem below (gitignore rule: a child cannot be re-included
# if its parent directory is excluded; using `dir/*` keeps the parent visible
# while ignoring its contents by default).
orchestrator/*
services/
gateway/
# memory-layer uses the star-form chain so the guard-rails audit migration
# (005) can be re-included below — a child can't be un-ignored if its parent
# directory is excluded outright.
memory-layer/*
!memory-layer/postgres/
memory-layer/postgres/*
!memory-layer/postgres/migrations/
memory-layer/postgres/migrations/*
!memory-layer/postgres/migrations/versions/
memory-layer/postgres/migrations/versions/*
!memory-layer/postgres/migrations/versions/*005_guard_rail_events.py
monitoring/
infrastructure/
ci-cd/
sdk/
tests/
docs/*
config/
dashboard/
scripts/
security/

# Ignore platform-level build files
alembic.ini
docker-compose.yml
pyproject.toml

# Local Claude Code state (keep agent definitions, ignore local settings)
.claude/settings.local.json

# ── Guard Rails subsystem — TRACKED for SOC2 audit trail ──
# Security-critical code lives in git so changes are reviewable and the
# audit trail is queryable. Scope is intentionally narrow: only the
# guard_rails module, its ADRs, and the eval set.
!orchestrator/guard_rails/
!orchestrator/guard_rails/**
# Re-ignore bytecode inside the re-included subtree (the ! above would
# otherwise override the global __pycache__/ rule — last match wins).
orchestrator/guard_rails/**/__pycache__/
!docs/adr-007-canary-and-pydantic-output.md
!docs/adr-008-rag-sanitization.md
!docs/adr-009-cross-agent-trust-boundary.md

# ── KEPT IN REPO ──
# .claude/agents/                    ← the 8 AI teammates
# demo-assets/                       ← director pitch, slide, demo evidence
# orchestrator/guard_rails/          ← guard rails subsystem (security audit trail)
# docs/adr-007/008/009-*.md          ← architecture decision records
# README.md                          ← repo overview
